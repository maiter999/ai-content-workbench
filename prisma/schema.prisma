generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  credits   Int      @default(100)
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contents Content[]
  transactions Transaction[]  // 添加这行
  orders Order[]  // 添加这行

  @@map("users")
}

model Content {
  id          String   @id @default(uuid())
  userId      String
  title       String
  body        String   @default("")
  topic       String   @default("")
  status      String   @default("draft")
  platforms   String   @default("[]")
  creditsUsed Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contents")
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  type        String   // 'consume' | 'recharge'
  amount      Int      // 积分变化量（正数为充值，负数为消费）
  balance     Int      // 变更后余额
  description String   // 描述（如：小红书图文生成、充值积分）
  platform    String?  // 平台（如：xiaohongshu、wechat，充值时为null）
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Order {
  id           String   @id @default(uuid())
  userId       String
  packageId    String   // 'basic' | 'standard' | 'pro'
  amount       Int      // 支付金额（分）
  credits      Int      // 购买积分数量
  status       String   @default("pending") // 'pending' | 'paid' | 'failed' | 'refunded'
  paymentMethod String? // 'wechat' | 'alipay'
  transactionId String? // 第三方支付交易号
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("orders")
}
