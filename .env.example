# Database
DATABASE_URL="file:./dev.db"

# DeepSeek API Key
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# ==================== 支付宝支付配置 ====================
# ⚠️ 注意：需要企业主体才能申请，个人用户请使用易支付（推荐）

# 注册地址: https://open.alipay.com/
# 1. 登录支付宝开放平台
# 2. 创建应用 -> 获取 App ID
# 3. 开发设置 -> 配置 RSA2 密钥对
# 4. 将私钥填入 ALIPAY_PRIVATE_KEY，公钥填入 ALIPAY_ALIPAY_PUBLIC_KEY

# 应用 ID
ALIPAY_APP_ID="your-alipay-app-id"

# 应用私钥（RSA2）- 格式：一行字符串，不能有换行
ALIPAY_PRIVATE_KEY="your-private-key-without-line-breaks"

# 支付宝公钥
ALIPAY_ALIPAY_PUBLIC_KEY="your-alipay-public-key"

# 支付成功回调地址（可选，必须是 HTTPS）
ALIPAY_NOTIFY_URL="https://your-domain.com/api/payments/alipay-callback"

# ==================== 易支付配置（个人可用）====================
# ⚠️ 推荐个人用户使用易支付，无需营业执照
# 注册地址: https://pay.ePays.cc/

# 易支付接口地址
EPAY_API_URL="https://pay.ePays.cc"

# 商户号（PID）
EPAY_PID="your-epay-pid"

# 商户密钥
EPAY_KEY="your-epay-key"

# 回调地址（必须是 HTTPS，外网可访问）
EPAY_NOTIFY_URL="https://your-domain.com/api/payments"

# 返回地址（支付后跳转的页面）
EPAY_RETURN_URL="https://your-domain.com/account"
